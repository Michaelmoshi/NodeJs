<%- include('./shared/header.ejs', {title: 'Bienvenue sur mon blog'}) %>

<div class="container" style="max-width:820px;">

  <%# Ajouté avec Claude %>
  <% if (locals.user) { %>
    <div class="form-card">
      <div class="form-card-header">
        <div class="form-card-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
        <div>
          <div class="title">Écrire un nouvel article</div>
          <div class="subtitle">Partage quelque chose avec tes lecteurs</div>
        </div>
      </div>

      <form action="" method="post">
        <div class="field">
          <label for="title">Titre</label>
          <input type="text" id="title" name="title" placeholder="Le titre de ton article">
        </div>

        <div class="field">
          <label for="content">Contenu</label>
          <textarea id="content" name="content" placeholder="Raconte..."></textarea>
        </div>

        <div class="form-card-footer">
          <span class="hint">Visible immédiatement après publication</span>
          <button type="submit" class="btn-accent">Publier l'article</button>
        </div>
      </form>
    </div>
  <% } %>
  <%# Fin ajout Claude %>

  <h1 class="my-5">Bienvenue sur mon blog</h1>

  <%# Ajouté avec Claude %>
  <div class="posts-grid">
  <%# Fin ajout Claude %>
    <%for (const post of posts) { %>
        <%- include('./shared/post.ejs', {post}) %>
    <% } %>
  <%# Ajouté avec Claude %>
  </div>
  <%# Fin ajout Claude %>

</div>


<%- include('./shared/footer.ejs') %>